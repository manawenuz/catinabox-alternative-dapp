# Etherscan key is public browser configuration and is embedded in the static build.
VITE_ETHERSCAN_API_KEY=your-etherscan-api-key

# Pinata credentials are used only by scripts/publish-ipfs.sh; never prefix with VITE_.
PINATA_API_KEY=your-pinata-api-key
PINATA_API_SECRET=your-pinata-api-secret
PINATA_JWT=your-pinata-jwt
